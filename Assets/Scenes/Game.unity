  - "\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0440\u044E\u043A\u0437\u0430\u043A"
  - 
  - 
  - 
  - "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0430"
  - "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0430"
  - 
  - 
  - 
  Descriptions:
  - "\u041F\u0443\u0441\u0442\u043E"
  - "\u0413\u0440\u0443\u0434\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0430, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u043D\u0430\u044F \u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u0430\u044F
    \u044D\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439"
  - "\u041A\u0443\u0441\u043A\u0438 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430,
    \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430"
  - "\u041E\u0441\u0442\u0430\u0442\u043A\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435
    \u043C\u0438\u043A\u0440\u043E\u0447\u0438\u043F\u044B \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0449\u0438\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B"
  - "\u0421\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0440\u0430\u0437\u043B\u043E\u0436\u043E\u043D\u043D\u044B\u0439 \u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u043D\u044B\u0439
    \u0441\u0440\u0435\u0434\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B"
